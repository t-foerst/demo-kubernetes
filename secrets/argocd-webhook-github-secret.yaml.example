apiVersion: v1
kind: Secret
metadata:
  name: argocd-webhook-github
  namespace: argocd
  labels:
    # nötig, damit ArgoCD den Verweis `$argocd-webhook-github:secret` aus argocd/values.yaml auflöst
    app.kubernetes.io/part-of: argocd
type: Opaque
stringData:
  secret: "<generate with: openssl rand -hex 32>"
